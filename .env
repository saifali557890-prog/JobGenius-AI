APP_NAME="JobGenius AI"
APP_ENV="development"
LOG_LEVEL="INFO"

# Database Configuration (Development defaults to SQLite if Postgres unavailable)
DB_ENGINE="sqlite"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="jobgenius_db"
DB_USER="postgres"
DB_PASSWORD="your_password_here"

# Model Configurations
EMBEDDING_MODEL_NAME="BAAI/bge-base-en-v1.5"
FAISS_INDEX_PATH="data/faiss_index.bin"